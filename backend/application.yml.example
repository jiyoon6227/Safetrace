server:
  port: 8080

spring:
  datasource:
    driver-class-name: oracle.jdbc.OracleDriver
    # 본인 DB 정보로 바꾸세요
    url: jdbc:oracle:thin:@localhost:1521:xe
    username: YOUR_DB_USERNAME
    password: YOUR_DB_PASSWORD
  servlet:
    multipart:
      max-file-size: 5MB
      max-request-size: 5MB
  # 이메일 발송 (SMTP) - 안전확인 요청 알림용
  # Gmail 기준: 구글 계정에서 "앱 비밀번호" 발급받아 password에 넣어야 함 (일반 로그인 비밀번호 아님)
  mail:
    host: smtp.gmail.com
    port: 587
    username: YOUR_GMAIL_ADDRESS
    password: YOUR_GMAIL_APP_PASSWORD
    properties:
      mail:
        smtp:
          auth: true
          starttls:
            enable: true

mybatis:
  mapper-locations: classpath:mappers/*.xml
  type-aliases-package: com.safetrace.domain
  configuration:
    map-underscore-to-camel-case: true
    # DB 컬럼(INCIDENT_ID) <-> 자바 필드(incidentId) 자동 매핑

logging:
  level:
    com.safetrace: debug
    org.springframework.security: debug

jwt:
  # 아무 문자열이나 32바이트 이상 무작위 값으로 직접 채우세요 (예: openssl rand -base64 48)
  secret: "YOUR_OWN_RANDOM_JWT_SECRET_MIN_32_BYTES"
  expiration-ms: 86400000   # 24시간

# 제보 사진 저장 위치 (백엔드 실행 폴더 기준 상대경로)
app:
  upload-dir: uploads
  # 이메일 안전확인 링크에 붙일 프론트엔드 주소 (배포 시 실제 도메인으로 변경)
  frontend-base-url: http://localhost:5173
  # 안전확인 이메일 토큰 유효시간 (시간 단위)
  safety-check-token-expiry-hours: 24

# 공공데이터포털(data.go.kr) 인증키 - 기상청 단기예보, 에어코리아 대기오염정보 등
publicdata:
  service-key: "YOUR_DATA_GO_KR_SERVICE_KEY"

# 재난안전데이터공유플랫폼(safetydata.go.kr) 인증키 - 긴급재난문자 전용 (위와 별개 발급)
safetydata:
  service-key: "YOUR_SAFETYDATA_GO_KR_SERVICE_KEY"
