# ============================================================
# SafeTrace 로컬 실행용 설정 예시
#
# 사용 방법
#   1. 이 파일을 backend/src/main/resources/application.yml 로 복사
#   2. YOUR_... 로 표시된 값을 본인 환경에 맞게 채우기
#   3. 실제 application.yml 은 Git에 커밋하지 않음 (.gitignore 처리됨)
#
# 운영 환경은 application.yml(공통) + application-prod.yml(DB·포트·도메인)로
# 프로필을 분리하고, 민감정보는 환경변수(${...})로 주입합니다.
# ============================================================


# ============================================================
# 서버
# ============================================================
server:
  port: 8080


# ============================================================
# Spring 공통
# ============================================================
spring:

  # ---------- DB (Oracle) ----------
  datasource:
    driver-class-name: oracle.jdbc.OracleDriver
    url: jdbc:oracle:thin:@localhost:1521:xe
    username: YOUR_DB_USERNAME
    password: YOUR_DB_PASSWORD

  # ---------- 파일 업로드 (제보 사진) ----------
  servlet:
    multipart:
      max-file-size: 5MB        # 파일 1개 최대 크기
      max-request-size: 5MB     # 요청 1건 전체 최대 크기

  # ---------- 메일 (Gmail SMTP) ----------
  # 이메일 인증 · 가족 안전확인 링크 발송용
  # password에는 Google 계정의 "앱 비밀번호"를 입력 (일반 로그인 비밀번호 아님)
  mail:
    host: smtp.gmail.com
    port: 587
    username: YOUR_GMAIL_ADDRESS
    password: YOUR_GMAIL_APP_PASSWORD
    properties:
      mail:
        smtp:
          auth: true
          starttls:
            enable: true


# ============================================================
# MyBatis
# ============================================================
mybatis:
  mapper-locations: classpath:mappers/*.xml
  type-aliases-package: com.safetrace.domain
  configuration:
    map-underscore-to-camel-case: true    # DB 컬럼(INCIDENT_ID) ↔ 자바 필드(incidentId) 자동 매핑


# ============================================================
# 로그
# 로컬 개발용으로 debug 설정 (운영 환경은 info 권장)
# ============================================================
logging:
  level:
    com.safetrace: debug
    org.springframework.security: debug


# ============================================================
# JWT
# ============================================================
jwt:
  secret: "YOUR_OWN_RANDOM_JWT_SECRET_MIN_32_BYTES"   # 32바이트 이상 무작위 문자열 (예: openssl rand -base64 48)
  expiration-ms: 3600000                              # 토큰 유효시간 1시간


# ============================================================
# 애플리케이션 설정
# ============================================================
app:
  upload-dir: uploads                          # 제보 사진 저장 경로 (backend 실행 폴더 기준)
  frontend-base-url: http://localhost:5173     # CORS · WebSocket 허용 Origin, 안전확인 이메일 링크 주소
  safety-check-token-expiry-hours: 24          # 안전확인 이메일 토큰 유효시간 (시간)


# ============================================================
# 공공 API 인증키
# ============================================================

# 공공데이터포털(data.go.kr) - 기상청 단기예보 · 특보, 에어코리아 대기질, 대피시설 등
publicdata:
  service-key: "YOUR_DATA_GO_KR_SERVICE_KEY"

# 재난안전데이터공유플랫폼(safetydata.go.kr) - 긴급재난문자 전용 (data.go.kr과 별도 발급)
safetydata:
  service-key: "YOUR_SAFETYDATA_GO_KR_SERVICE_KEY"


# ============================================================
# Groq AI (AI 안전 브리핑 · 자유질문)
# ============================================================
groq:
  api-key: "YOUR_GROQ_API_KEY"
  model: qwen/qwen3.8-27b